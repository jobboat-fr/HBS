# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=

# Resend
RESEND_API_KEY=
CONTACT_NOTIFY_TO=
CONTACT_FROM=

# Site
NEXT_PUBLIC_SITE_URL=https://www.hbs-formation.fr

# LEARN — la plateforme de formation (AZZ&CO). Sans LEARN_API_URL, les pages du tunnel
# (/preinscription, /positionnement/[token]) dégradent vers le parcours de contact.
LEARN_API_URL=http://127.0.0.1:8099
# L'identifiant de l'organisme dans la plateforme multi-tenant.
LEARN_TENANT_SLUG=hbs
# Optionnel : jeton partagé si la passerelle filtre l'origine des appels publics.
LEARN_API_TOKEN=
